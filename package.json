{
  "name": "timeline-visualizer-web",
  "private": true,
  "version": "1.7.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cap:sync": "npm run build && npx cap sync android",
    "android:bundle": "npm run cap:sync && cd android && gradlew.bat bundleRelease",
    "android:apk": "npm run cap:sync && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/splash-screen": "^7.0.5",
    "mediabunny": "1.55.1"
  },
  "devDependencies": {
    "@playwright/test": "1.54.2",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  }
}
